{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      ".*",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "implementation-prompts/**",
      "scripts/**",
      "חשבון רעיה/**",
      "run_implementation_prompts.py"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
